{
  "name": "task-note",
  "version": "1.0.0",
  "license": "GPL-3.0-only",
  "type": "module",
  "description": "TaskNote App - Your daily-basis friend to help you with TODOs and Notes",
  "keywords": [
    "react",
    "typescript",
    "node",
    "nestjs"
  ],
  "repository": "https://lightroasted.vps-kinghost.net/rmcampos/tasknote",
  "private": true,
  "dependencies": {
    "@milkdown/kit": "^7.23.0",
    "@milkdown/react": "^7.23.0",
    "@popperjs/core": "^2.11.8",
    "@types/node": "^26.6.6",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "bootstrap": "^5.3.8",
    "dompurify": "^3.4.17",
    "i18next": "^26.7.2",
    "react": "^19.3.1",
    "react-bootstrap": "^2.10.10",
    "react-bootstrap-icons": "^1.11.6",
    "react-charts": "^3.0.0-beta.57",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.1.13",
    "react-router": "^8.5.1",
    "react-router-bootstrap": "^0.26.3",
    "typescript": "^6.0.3",
    "vite": "^8.3.6"
  },
  "scripts": {
    "start": "vite --host",
    "build": "tsc && vite build",
    "preview": "vite build && vite preview",
    "test": "vitest",
    "test:no-watch": "vitest --watch=false",
    "test:coverage": "vitest run --coverage --watch=false",
    "lint": "npx oxlint .",
    "lint:fix": "npx oxlint --fix",
    "cypress:open": "cypress open",
    "cypress:run": "cypress run",
    "cypress:run:headless": "cypress run --headless"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/jest": "^30.0.0",
    "@types/react": "^19.3.0",
    "@types/react-router-bootstrap": "^0.26.8",
    "@vitest/coverage-v8": "^5.1.0",
    "cypress": "^16.2.1",
    "globals": "^17.14.0",
    "jsdom": "^31.0.0",
    "oxlint": "^1.94.0",
    "prettier": "^3.9.10",
    "sass": "^1.108.0",
    "source-map-support": "^0.5.21",
    "vitest": "^5.0.5"
  }
}
